/**
 * Material 3 Slate/Neutral - Simple Menu Theme for Rofi
 * No input bar - just clean option selection 
 */

 
* {
bg-primary:        #16161e;  /* main background */
bg-surface:        #1b1d2a;  /* elevated panels */
bg-container:      #222536;  /* container backgrounds */

primary:           #7aa2f7;  /* active / highlight */
primary-container: #2a2f45;  /* darker container for primary elements */
on-primary:        #d6defb;  /* text/icons on primary surfaces */

/* Secondary colors */
secondary:         #a9b1d6;  /* secondary text / less prominent elements */
secondary-container:#222536; /* darker secondary surfaces */

/* Surface layers (Adwaita-style elevation) */
surface-1:         #16161e;  /* subtle elevation */
surface-2:         #1b1d2a;  /* intermediate elevation */
surface-3:         #222536;  /* hover / panels / overlays */

/* Text colors */
text-primary:      #c0caf5;  /* main text */
text-secondary:    #a9b1d6;  /* muted secondary text */
text-disabled:     #565f89;  /* disabled / low emphasis text */

/* Borders */
border-color:      #3b4261;  /* subtle border color for dividers / outlines */
    /* General UI */
    background-color: transparent;
    text-color:       @text-primary;
}

window {
    background-color: @bg-primary;
    border: 0px;
    border-color: @border-color;
    border-radius: 24px;
    padding: 20px;
    width: 400px;
    location: center;
    transparency: "real";
}

mainbox {
    spacing: 0px;
    children: [ listview ];
}

listview {
    columns: 1;
    lines: 8;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: false;
}

element {
    background-color: @surface-1;
    text-color: @text-primary;
    border-radius: 16px;
    padding: 14px 20px;
    cursor: pointer;
}

element-text {
    font: "Roboto 11";
    vertical-align: 0.5;
    horizontal-align: 0.0;
    text-color: inherit;
}

/* Normal state */
element normal.normal {
    background-color: @surface-1;
    text-color: @text-primary;
}

/* Selected/Hover state */
element selected.normal {
    background-color: @primary-container;
    text-color: @text-primary;
}

element selected.normal element-text {
    font: "Roboto Medium 11";
}

/* Alternate rows (same as normal for consistency) */
element alternate.normal {
    background-color: @surface-1;
    text-color: @text-primary;
}

/* Scrollbar (if needed for many items) */
scrollbar {
    handle-width: 6px;
    handle-color: @border-color;
    background-color: @bg-surface;
    border-radius: 8px;
    margin: 0px 0px 0px 8px;
}
