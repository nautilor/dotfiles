* {
	bg-primary:        #14141b;
	bg-secondary:      #16161e;
	bg-container:      #1b1d2a;
	primary:           #7aa2f7;
	on-primary:        #d6defb;
	text-primary:      #c0caf5;
	text-secondary:    #a9b1d6;
	text-disabled:     #565f89;
	background-color: transparent;
	text-color:       @text-primary;
}

window {
	background-color: @bg-primary;
	border: 0px;
	border-color: @border-color;
	border-radius: 100px;
	padding: 10px;
	margin: 10px;
	width: 100px;
	location: east;
	transparency: "real";
}

mainbox {
	spacing: 0px;
	children: [ listview ];
}

listview {
	columns: 1;
	lines: 4;
	spacing: 8px;
	cycle: false;
	dynamic: false;
	layout: vertical;
}

element {
	background-color: @bg-primary;
	border-radius: 100px;
	orientation: vertical;
	padding: 16px;
	cursor: pointer;
	spacing: 0px;
}

element-text {
	font: "JetBrainsMono Nerd Font Propo 16";
	horizontal-align: 0.5;
	vertical-align: 0.5;
	text-color: inherit;
}

element selected normal {
	background-color: @primary;
	text-color: @on-primary;
}

